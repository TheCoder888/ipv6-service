# Command run when the IPv6 changes. CURRENT_IPV6 and OLD_IPV6 are available.
CHANGE_COMMAND='/usr/local/libexec/noip-ipv6-update "$CURRENT_IPV6"'

# Optional interface name, for example: enp3s0
INTERFACE=

# An IPv6 destination used only for a local route lookup; no packet is sent.
PROBE_ADDRESS=2606:4700:4700::1111
